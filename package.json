{
  "name": "icone-motion",
  "version": "1.0.0",
  "private": true,
  "description": "Motion graphics institucional da ICone — plataforma para gelateria profissional (Remotion)",
  "scripts": {
    "dev": "remotion studio",
    "predev": "node scripts/ensure-ffmpeg.mjs",
    "render": "remotion render Main out/icone-institucional.mp4 --concurrency=4",
    "prerender": "node scripts/ensure-ffmpeg.mjs",
    "render:wsl": "wsl -d Ubuntu-24.04 -- bash scripts/wsl-render.sh Main out/icone-institucional.mp4",
    "render:scene": "remotion render",
    "render:campaign:01": "powershell -ExecutionPolicy Bypass -File scripts/render-campaign-01.ps1",
    "render:campaign:01:vertical": "remotion render Campaign01Vertical15s out/campaign-01/icone-campaign-01-vertical.mp4 --concurrency=4",
    "render:campaign:02": "powershell -ExecutionPolicy Bypass -File scripts/render-campaign-02.ps1",
    "render:campaign:02:vertical": "remotion render Campaign02Vertical20s out/campaign-02/icone-campaign-02-vertical.mp4 --concurrency=4",
    "render:campaign:03": "powershell -ExecutionPolicy Bypass -File scripts/render-campaign-03.ps1",
    "render:campaign:03:vertical": "remotion render Campaign03Vertical24s out/campaign-03/icone-campaign-03-vertical.mp4 --concurrency=4",
    "render:campaign:04": "powershell -ExecutionPolicy Bypass -File scripts/render-campaign-04.ps1",
    "render:campaign:04:vertical": "remotion render Campaign04Vertical30s out/campaign-04/icone-campaign-04-vertical.mp4 --concurrency=4",
    "render:campaign:05": "node scripts/render-campaign-05.mjs --include-clean",
    "render:campaign:05:master": "remotion render Campaign05MasterHorizontal75s out/campaign-05/icone-campaign-05-master-horizontal.mp4 --concurrency=4",
    "render:campaign:05:vertical": "remotion render Campaign05MasterVertical75s out/campaign-05/icone-campaign-05-master-vertical.mp4 --concurrency=4",
    "render:campaign:05:ads": "node scripts/render-campaign-05.mjs --only-ads",
    "fix:compositor": "powershell -ExecutionPolicy Bypass -File scripts/fix-compositor.ps1",
    "fix:ffmpeg": "node scripts/ensure-ffmpeg.mjs",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/ensure-ffmpeg.mjs"
  },
  "engines": {
    "node": ">=18 <25"
  },
  "dependencies": {
    "@remotion/cli": "4.0.500",
    "@remotion/google-fonts": "4.0.500",
    "lucide-react": "^0.525.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.500"
  },
  "optionalDependencies": {
    "@remotion/compositor-win32-x64-msvc": "4.0.500"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.8.2"
  }
}
