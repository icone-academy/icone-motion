{
  "name": "icone-motion",
  "version": "1.0.0",
  "private": true,
  "description": "Motion graphics institucional da Ícone — plataforma para gelateria profissional (Remotion)",
  "scripts": {
    "dev": "remotion studio",
    "render": "remotion render Main out/icone-institucional.mp4",
    "render:wsl": "wsl -d Ubuntu-24.04 -- bash scripts/wsl-render.sh Main out/icone-institucional.mp4",
    "render:scene": "remotion render",
    "fix:compositor": "powershell -ExecutionPolicy Bypass -File scripts/fix-compositor.ps1",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.257",
    "@remotion/google-fonts": "^4.0.257",
    "lucide-react": "^0.525.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.257"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.8.2"
  }
}
